def make_wrapper_art(dest_dir, set_code, set_name):
    """Generate a simple booster-wrapper image. Returns path or None."""
    try:
        from PIL import Image, ImageDraw, ImageFont
    except ImportError:
        return None

    # Real draft-booster wrapper proportions (~7.3 x 11 cm)
    W, H = 460, 700
    img = Image.new("RGB", (W, H), (24, 20, 40))
    draw = ImageDraw.Draw(img)

    # Layered background bands for a bit of booster flair
    for i, color in enumerate([(49, 36, 90), (84, 48, 125), (190, 120, 35)]):
        draw.polygon([(0, 180 + i * 150), (W, 100 + i * 150),
                      (W, 160 + i * 150), (0, 240 + i * 150)], fill=color)
    draw.rectangle([14, 14, W - 14, H - 14], outline=(212, 175, 55), width=4)

    def font(size):
        for name in ("arialbd.ttf", "arial.ttf", "DejaVuSans-Bold.ttf",
                     "DejaVuSans.ttf"):
            try:
                return ImageFont.truetype(name, size)
            except Exception:
                continue
        return ImageFont.load_default()

    def center_text(y, text, size, fill=(240, 234, 214)):
        f = font(size)
        box = draw.textbbox((0, 0), text, font=f)
        draw.text(((W - (box[2] - box[0])) / 2, y), text, font=f, fill=fill)

    center_text(50, "DRAFT NIGHT", 40)
    center_text(290, set_code.upper(), 115, fill=(255, 215, 90))
    # Set name, shrunk to fit if long
    name = set_name if len(set_name) <= 24 else set_name[:22] + "..."
    center_text(468, name, 30)
    center_text(608, "15 CARDS", 28, fill=(200, 195, 180))

    path = Path(dest_dir) / "pack_wrapper.jpg"
    img.save(path, "JPEG", quality=90)
    return path


ART_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp")


def collect_art_files(folder):
    return sorted(p for p in Path(folder).iterdir()
                  if p.is_file() and p.suffix.lower() in ART_EXTENSIONS)


def resolve_wrapper_art(pack_art_arg, images_dir, dest, set_code, set_name,
                        back_url):
    """Decide which wrapper images to use, copy them into the shared set
    folder (so the friends-zip includes them), and return a list of file
    URLs. Priority: --pack-art (file or folder) > auto art library folder
    > generated art > card back."""
    sources = []
    if pack_art_arg:
        src = Path(pack_art_arg)
        if not src.exists():
            sys.exit(f"--pack-art not found: {src}")
        sources = collect_art_files(src) if src.is_dir() else [src]
        if not sources:
            sys.exit(f"No images (.jpg/.png/.webp) found in {src}")
        print(f"Using {len(sources)} wrapper image(s) from --pack-art {src}")
    else:
        auto_dir = Path(images_dir) / "pack_art" / set_code.lower()
        if auto_dir.is_dir():
            sources = collect_art_files(auto_dir)
        if sources:
            print(f"Using {len(sources)} wrapper image(s) from your art "
                  f"library: {auto_dir}")
        else:
            print(f"No art library folder at {auto_dir} — "
                  f"using generated wrapper art.")

    if sources:
        urls = []
        for i, src in enumerate(sources, 1):
            target = dest / f"pack_wrapper_{i:02d}{src.suffix.lower()}"
            shutil.copyfile(src, target)
            urls.append(file_url(target))
        return urls

    generated = make_wrapper_art(dest, set_code, set_name)
    if generated:
        return [file_url(generated)]
    print("Pillow not installed — using the card back as wrapper art.")
    print("For generated wrapper art, run:  pip install pillow")
    return [back_url]


# ---------------------------------------------------------------------------
# TTS objects
# ---------------------------------------------------------------------------

def tts_transform(x=0, y=1, z=0, rot_y=180, rot_z=180,
                  sx=1.0, sy=1.0, sz=1.0):
    return {"posX": x, "posY": y, "posZ": z,
            "rotX": 0, "rotY": rot_y, "rotZ": rot_z,
            "scaleX": sx, "scaleY": sy, "scaleZ": sz}


def make_deck_json(pack_cards, label, face_urls, back_faces, back_url, next_deck_id):
    """The deck a pack spawns when opened — same shape mtg_draft_night uses."""
    custom_deck, contained, deck_ids = {}, [], []
    for card in pack_cards:
        deck_id = next_deck_id[0]
        next_deck_id[0] += 1
        # For double-faced cards, TTS uses the second face as the card's
        # reverse image. UniqueBack must be enabled so TTS does not substitute
        # the shared deck back. Ordinary cards retain the normal MTG back.
        reverse_url = back_faces.get(card_key(card), back_url)
        custom_deck[str(deck_id)] = {
            "FaceURL": face_urls[card_key(card)],
            "BackURL": reverse_url,
            "NumWidth": 1, "NumHeight": 1,
            "BackIsHidden": True, "UniqueBack": card_key(card) in back_faces,
        }
        contained.append({
            "Name": "Card",
            "Nickname": card.get("name", "Unknown"),
            "Description": card.get("type_line", ""),
            "CardID": deck_id * 100,
            "Transform": tts_transform(),
            "ContainedObjects": [],
        })
        deck_ids.append(deck_id * 100)
    return {
        "Name": "DeckCustom",
        "Nickname": label,
        "Description": "Fresh from the pack",
        "Transform": tts_transform(),
        "DeckIDs": deck_ids,
        "CustomDeck": custom_deck,
        "ContainedObjects": contained,
    }


