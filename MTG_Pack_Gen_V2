def make_pack_object(deck_json_obj, pack_label, position, wrapper_url):
    deck_str = json.dumps(deck_json_obj)
    if "]=====]" in deck_str:  # paranoia: never collide with Lua's long bracket
        deck_str = deck_str.replace("]=====]", "] =====]")
    if len(position) == 3:
        x, y, z = position
    else:
        x, z = position
        y = 1.0
    return {
        "Name": "CardCustom",
        "Nickname": pack_label,
        "Description": "Sealed booster — click Open to crack it",
        # face-up so the wrapper art shows; scaled to real booster
        # proportions (slightly narrower and taller than a card)
        "Transform": tts_transform(x=x, y=y, z=z, rot_z=0, sx=1.2, sy=1.0, sz=1.3),
        "CardID": 100,
        "CustomDeck": {
            "1": {
                "FaceURL": wrapper_url,
                "BackURL": wrapper_url,
                "NumWidth": 1, "NumHeight": 1,
                "BackIsHidden": False, "UniqueBack": False,
            }
        },
        "LuaScript": PACK_LUA % deck_str,
        "ContainedObjects": [],
    }


def grid_positions(count, per_row=4, spacing_x=4.2, spacing_z=5.8):
    positions = []
    for i in range(count):
        row, col = divmod(i, per_row)
        x = (col - (per_row - 1) / 2) * spacing_x
        z = row * -spacing_z
        positions.append((x, z))
    return positions


def build_saved_object(packs, set_code, face_urls, back_faces, back_url, wrapper_urls, rng,
                       layout="grid", stack_spacing=0.08):
    """Build TTS saved objects arranged as a grid or a vertical stack."""
    objects = []
    next_deck_id = [1]
    per_row = 4 if len(packs) <= 16 else 6
    if layout == "stack":
        # Keep X/Z aligned and raise each pack slightly above the previous one.
        # A small vertical gap prevents the physics engine from merging them.
        positions = [(0.0, 1.0 + i * stack_spacing, 0.0)
                     for i in range(len(packs))]
    else:
        positions = grid_positions(len(packs), per_row=per_row)
    for i, pack in enumerate(packs):
        label = f"{set_code.upper()} Booster {i + 1}"
        deck = make_deck_json(pack, label, face_urls, back_faces, back_url, next_deck_id)
        wrapper = rng.choice(wrapper_urls)
        objects.append(make_pack_object(deck, label, positions[i], wrapper))
    return {"ObjectStates": objects}


# ---------------------------------------------------------------------------
# Scryfall set discovery
# ---------------------------------------------------------------------------

def list_scryfall_sets(include_normal=False):
    """Print useful Scryfall set codes so the script can discover new products."""
    data = fetch_json("https://api.scryfall.com/sets")
    if data.get("object") == "error":
        sys.exit("Could not retrieve Scryfall's set list.")

    sets = data.get("data", [])
    special_types = {
        "masters", "draft_innovation", "commander", "box",
        "from_the_vault", "spellbook", "premium_deck", "duel_deck",
        "arsenal", "promo", "funny", "starter", "planechase",
        "archenemy", "treasure_chest",
    }
    for s in sets:
        if include_normal or s.get("set_type") in special_types or \
                s.get("code", "").lower().startswith("sl"):
            print(f"{s.get('code','').upper():5}  {s.get('name','')}  "
                  f"[{s.get('set_type','')}, {s.get('card_count',0)} cards]")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Generate clickable, openable MTG booster packs for TTS.")
    parser.add_argument("--set", required=False, dest="set_codes", nargs="+",
                        help="One or more Scryfall set codes, e.g. --set dtk ktk frf")
    parser.add_argument("--query", default=None,
                        help='Custom Scryfall query, e.g. "set:sld" or "set:sld cn:500". '
                        "Overrides --set card selection.")
    parser.add_argument("--mode", choices=("draft", "pool", "weighted"), default="draft",
                        help="draft = conventional rarity slots; pool = equal-chance "
                             "random selection; weighted = traditional-feeling rarity "
                             "slots with fallback for special products (default: draft)")
    parser.add_argument("--extras", action="store_true",
                        help="Add a separate TTS deck with the set's tokens, emblems and reference cards")
    parser.add_argument("--extras-only", action="store_true",
                        help="Generate only the set's tokens, emblems and reference cards; no boosters")
    parser.add_argument("--include-promos", action="store_true",
                        help="Allow promotional printings from the set and its p-prefixed promo set")
    parser.add_argument("--include-variants", action="store_true",
                        help="Allow showcase, borderless, full-art, and other alternate printings")
    parser.add_argument("--special-chance", type=float, default=0.15,
                        help="Chance to replace an eligible card with special printing (default: 0.15)")
    parser.add_argument("--all-printings", action="store_true",
                        help="In pool/query mode, include distinct Scryfall printings rather than one per card")
    parser.add_argument("--cards-per-pack", type=int, default=15,
                        help="Cards per pool pack (default: 15)")
    parser.add_argument("--common-slots", type=int, default=10,
                        help="Weighted mode: common slots (default: 10)")
    parser.add_argument("--uncommon-slots", type=int, default=3,
                        help="Weighted mode: uncommon slots (default: 3)")
    parser.add_argument("--rare-slots", type=int, default=1,
                        help="Weighted mode: rare/mythic slots (default: 1)")
    parser.add_argument("--flex-slots", type=int, default=1,
                        help="Weighted mode: flexible slots, prefers basic lands (default: 1)")
    parser.add_argument("--mythic-chance", type=float, default=0.125,
                        help="Weighted mode: chance 0-1 for rare slot to upgrade to mythic (default: 0.125)")
    parser.add_argument("--list-special-sets", action="store_true",
                        help="List Scryfall's non-standard/special set codes and exit")
    parser.add_argument("--list-all-sets", action="store_true",
                        help="List every Scryfall set code and exit")
    parser.add_argument("--players", type=int, default=4)
    parser.add_argument("--packs-per-player", type=int, default=3)
    parser.add_argument("--packs", type=int, default=None,
                        help="Total packs (overrides players x packs-per-player)")
    parser.add_argument("--layout", choices=("grid", "stack"), default="grid",
                        help="Spawn packs in a spaced grid (default) or one vertical stack")
    parser.add_argument("--stack-spacing", type=float, default=0.08,
                        help="Vertical spacing between stacked packs in TTS units (default: 0.08)")
    parser.add_argument("--seed", type=int, default=None)
    parser.add_argument("--out", default=None,
                        help="Output JSON (default: boosters_<set>.json)")
    parser.add_argument("--images-dir", default=None,
                        help="Folder for downloaded images "
                             "(default: C:\\Users\\Public\\TTSDraftImages)")
    parser.add_argument("--pack-art", default=None,
                        help="Your own wrapper image file OR a folder of images "
                             "(overrides the pack_art/<set> art library)")
    args = parser.parse_args()

    if args.list_special_sets or args.list_all_sets:
        list_scryfall_sets(include_normal=args.list_all_sets)
        return

    if (args.extras or args.extras_only) and not args.set_codes:
        sys.exit("--extras and --extras-only require --set CODE [CODE ...].")
    if not args.set_codes and not args.query:
        sys.exit("Provide --set CODE [CODE ...] or --query 'SCRYFALL QUERY'.")
    if not 0 <= args.special_chance <= 1:
        sys.exit("--special-chance must be between 0 and 1.")
    if args.cards_per_pack < 1:
        sys.exit("--cards-per-pack must be at least 1.")
    if min(args.common_slots, args.uncommon_slots, args.rare_slots,
           args.flex_slots) < 0:
        sys.exit("Weighted slot counts cannot be negative.")
    if not 0 <= args.mythic_chance <= 1:
        sys.exit("--mythic-chance must be between 0 and 1.")
    if args.mode == "weighted" and not (args.common_slots + args.uncommon_slots +
                                        args.rare_slots + args.flex_slots):
        sys.exit("Weighted mode must have at least one slot.")

    if args.extras_only:
        codes = [c.lower() for c in args.set_codes]
        set_code = "_".join(codes)
        images_dir = args.images_dir or default_images_dir()
        extras = fetch_set_extras(codes)
        if not extras:
            sys.exit("No token, emblem or reference card printings found for this set.")
        extra_fronts, extra_backs, extra_back, dest = download_images(
            [extras], images_dir, set_code)
        obj = build_extras_object(extras, f"{set_code.upper()} Tokens & Extras",
                                  extra_fronts, extra_backs, extra_back)
        out_path = args.out or f"boosters_{set_code.lower()}_extras.json"
        with open(out_path, "w", encoding="utf-8") as f:
            json.dump({"ObjectStates": [obj]}, f, indent=2)
        zip_path = shutil.make_archive(f"draft_images_{set_code.lower()}", "zip",
                                       root_dir=dest.parent, base_dir=dest.name)
        print(f"\nDone! Wrote {out_path} ({len(extras)} extras).")
        print(f"Images archive: {zip_path}")
        print("Copy the JSON into Documents/My Games/Tabletop Simulator/Saves/Saved Objects/")
        return

    rng = random.Random(args.seed)
    total_packs = args.packs if args.packs is not None else \
        args.players * args.packs_per_player
    if total_packs < 1:
        sys.exit("Pack count must be at least 1.")
    if args.stack_spacing <= 0:
        sys.exit("--stack-spacing must be greater than 0.")

    if args.query:
        print(f"Fetching Scryfall query: {args.query}")
        cards = fetch_cards_query(args.query, unique="prints" if args.all_printings else "cards")
        if not cards:
            sys.exit(f"No cards found for Scryfall query: {args.query}")
        set_name = f"Custom: {args.query}"
        set_code = "_".join(c.lower() for c in args.set_codes) if args.set_codes else "custom"
        released_at = ""
        card_count = len(cards)
    else:
        codes = [c.lower() for c in args.set_codes]
        set_code = "_".join(codes)
        names = []
        cards = []
        seen_ids = set()
        card_count = 0
        special_cards = []
        for code in codes:
            print(f"Fetching '{code}' from Scryfall...")
            name, released_at, listed_count = fetch_set_meta(code)
            set_cards = fetch_set_cards(
                code, released_at, use_booster_filter=(args.mode == "draft"))
            if args.include_promos or args.include_variants:
                specials = fetch_special_printings(code, args.include_promos, args.include_variants)
                special_cards.extend(specials)
                print(f"  Found {len(specials)} eligible special printings for {code.upper()}")
            names.append(name)
            card_count += listed_count
            for card in set_cards:
                card_id = card.get("id")
                if card_id and card_id in seen_ids:
                    continue
                if card_id:
                    seen_ids.add(card_id)
                cards.append(card)
        set_name = " + ".join(names)

    if card_count:
        label = "card pool" if args.mode in ("pool", "weighted") or args.query else "draftable cards"
        print(f"  {set_name}: pulled {len(cards)} {label} "
              f"(combined set lists {card_count})")

    if args.mode == "pool":
        if len(cards) < args.cards_per_pack:
            print(f"  Warning: only {len(cards)} cards are available; "
                  f"packs may contain duplicates.")
        print(f"  Custom pool mode: {args.cards_per_pack} cards per pack")
        packs = [build_pool_pack(cards, args.cards_per_pack, rng)
                 for _ in range(total_packs)]
    elif args.mode == "weighted":
        total_slots = (args.common_slots + args.uncommon_slots +
                       args.rare_slots + args.flex_slots)
        print("  Weighted mode slots: "
              f"{args.common_slots} common, {args.uncommon_slots} uncommon, "
              f"{args.rare_slots} rare/mythic, {args.flex_slots} flexible "
              f"({total_slots} cards per pack; mythic upgrade {args.mythic_chance:.1%})")
        packs = [build_weighted_pack(
                    cards, rng, args.common_slots, args.uncommon_slots,
                    args.rare_slots, args.flex_slots, args.mythic_chance)
                 for _ in range(total_packs)]
    elif args.query:
        if len(cards) < args.cards_per_pack:
            print(f"  Warning: only {len(cards)} cards are available; "
                  f"packs may contain duplicates.")
        print(f"  Custom query pool mode: {args.cards_per_pack} cards per pack")
        packs = [build_pool_pack(cards, args.cards_per_pack, rng)
                 for _ in range(total_packs)]
    else:
        buckets = bucket_by_rarity(cards)
        print(f"  {len(buckets['common'])} commons, {len(buckets['uncommon'])} "
              f"uncommons, {len(buckets['rare'])} rares, {len(buckets['mythic'])} "
              f"mythics, {len(buckets['basic'])} basics")
        print(f"Building {total_packs} draft-style packs...")
        packs = [build_pack(buckets, rng) for _ in range(total_packs)]

    if not args.query and (args.include_promos or args.include_variants):
        swaps = substitute_specials(packs, special_cards, args.special_chance, rng)
        print(f"  Substituted {swaps} promotional/alternate-art card printings")

    images_dir = args.images_dir or default_images_dir()
    face_urls, back_faces, back_url, dest = download_images(packs, images_dir, set_code)

    wrapper_urls = resolve_wrapper_art(args.pack_art, images_dir, dest,
                                       set_code, set_name, back_url)

    saved_object = build_saved_object(packs, set_code, face_urls,
                                      back_faces, back_url, wrapper_urls, rng,
                                      layout=args.layout,
                                      stack_spacing=args.stack_spacing)
    if args.extras:
        codes = [c.lower() for c in args.set_codes]
        extras = fetch_set_extras(codes)
        if extras:
            extra_fronts, extra_backs, extra_back, _ = download_images(
                [extras], images_dir, set_code)
            extra_obj = build_extras_object(
                extras, f"{set_code.upper()} Tokens & Extras",
                extra_fronts, extra_backs, extra_back)
            saved_object["ObjectStates"].append(extra_obj)
            print(f"  Added a separate TTS object with {len(extras)} set extras.")
        else:
            print("  No set extras found; booster output is unchanged.")
    out_path = args.out or f"boosters_{set_code.lower()}.json"
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(saved_object, f, indent=2)

    zip_path = shutil.make_archive(
        f"draft_images_{set_code.lower()}", "zip",
        root_dir=dest.parent, base_dir=dest.name)

    rare_names = [p[0].get("name", "?") for p in packs if p]
    print(f"\nDone! Wrote {out_path}")
    print(f"Rare slots: {', '.join(rare_names)}")
    print("\nTo use in Tabletop Simulator:")
    print("  1. Copy the JSON into  Documents/My Games/Tabletop Simulator/"
          "Saves/Saved Objects/")
    print("  2. Objects -> Saved Objects -> click your file")
    print(f"  3. Pack layout: {args.layout}. Sealed packs spawn face-up. "
          "Click a pack's Open button to crack it — the wrapper vanishes "
          "and the cards drop in its place!")
    print(f"\nFor your friends: send {zip_path}")
    print(f"  They extract it into:  {Path(images_dir)}")
    print(f"  (must end up at {Path(images_dir) / set_code.lower()})")
    print(f"\nArt library tip: drop wrapper images into")
    print(f"  {Path(images_dir) / 'pack_art' / set_code.lower()}")
    print(f"  and future runs for this set will use them automatically,")
    print(f"  giving each pack a randomly chosen wrapper.")


if __name__ == "__main__":
    main()
