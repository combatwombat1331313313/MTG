#!/usr/bin/env python3
"""
MTG Booster Packs for Tabletop Simulator — clickable, openable packs.

A companion to mtg_draft_night.py (which stays untouched). Instead of
spawning bare face-down decks, this script creates booster PACK objects:
each pack sits on the table showing wrapper art with an "Open" button.
Clicking Open makes the pack vanish and its 15 cards appear as a
face-down deck in its place.

Like mtg_draft_night.py, all card images are downloaded locally so TTS
never has to talk to Scryfall (which blocks TTS's downloader).

Usage:
    # Normal draft-style booster generation
    python mtg_booster_packs.py --set ktk --packs 24
    python mtg_booster_packs.py --set dsk --players 4 --packs-per-player 3

    # Non-draftable/special product: make 15-card packs from the whole set
    python mtg_booster_packs.py --set sld --mode pool --packs 24

    # Traditional-feeling rarity slots for a non-booster product
    python mtg_booster_packs.py --set who --mode weighted --packs 24

    # Spawn all packs in one vertical stack instead of a grid
    python mtg_booster_packs.py --set who --mode weighted --packs 24 --layout stack

    # Secret Lair/custom pool using a Scryfall search query
    python mtg_booster_packs.py --query "set:sld" --cards-per-pack 5 --packs 24

    # Discover current Scryfall special-set codes
    python mtg_booster_packs.py --list-special-sets

    # Use a custom number of cards per pool pack
    python mtg_booster_packs.py --set who --mode pool --cards-per-pack 10 --packs 24

    # Any Scryfall search query can define the card pool
    python mtg_booster_packs.py --query "set:sld color:g" --cards-per-pack 8 --packs 12

Wrapper art: if the Pillow library is installed (pip install pillow),
the script generates a styled wrapper per set automatically. Without
Pillow it falls back to the MTG card back, or use --pack-art to supply
your own image.

Requires Python 3.8+. Pillow is optional but recommended.
"""

import argparse
import json
import os
import random
import shutil
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

SCRYFALL_API = "https://api.scryfall.com/cards/search"
USER_AGENT = "MTGDraftNightTTS/1.0 (personal draft-night script)"

CARD_BACK_URL = (
    "https://backs.scryfall.io/large/0/a/0aeebaf5-8c7d-4636-9e82-8c27447861f7.jpg"
)

MYTHIC_CHANCE = 1 / 8


# ---------------------------------------------------------------------------
# Scryfall fetching (same approach as mtg_draft_night.py)
# ---------------------------------------------------------------------------

def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT,
                                               "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        # Scryfall answers zero-result searches with HTTP 404.
        return {"object": "error", "status": e.code}


def fetch_set_meta(set_code):
    """Set name, release date, and printed card count from Scryfall."""
    try:
        data = fetch_json(f"https://api.scryfall.com/sets/{set_code.lower()}")
        if data.get("object") == "set":
            return (data.get("name", set_code.upper()),
                    data.get("released_at", ""),
                    data.get("card_count", 0))
    except Exception:
        pass
    return set_code.upper(), "", 0


def fetch_cards_query(query, unique="cards"):
    """Fetch all cards matching an arbitrary Scryfall search query."""
    cards = []
    url = SCRYFALL_API + "?" + urllib.parse.urlencode({
        "q": query, "unique": unique, "order": "set"
    })
    while url:
        data = fetch_json(url)
        if data.get("object") == "error":
            break
        cards.extend(data.get("data", []))
        url = data.get("next_page")
        time.sleep(0.1)
    return cards


def fetch_set_cards(set_code, released_at="", use_booster_filter=True):
    """Fetch a set's draftable cards.

    Scryfall's per-card is:booster flag keeps planeswalker-deck and promo
    cards out of modern packs, but it's incomplete for old sets (Urza's
    Legacy loses 40 cards to it). Sets released before 2014 predate
    non-booster cards in main set files entirely, so they get the plain
    unfiltered query; newer sets use is:booster with a plain fallback.
    """
    if use_booster_filter and released_at and released_at < "2014-01-01":
        queries = [f"e:{set_code}"]
    elif use_booster_filter:
        queries = [f"e:{set_code} is:booster", f"e:{set_code}"]
    else:
        queries = [f"e:{set_code}"]
    for query in queries:
        cards = fetch_cards_query(query)
        if cards:
            return cards
    sys.exit(f"No cards found for set code '{set_code}'. "
             f"Check the code at scryfall.com/sets.")



def fetch_special_printings(set_code, include_promos=False, include_variants=False):
    """Find printings in the requested set and its matching p-prefixed promo set.

    Keep individual printings (unique=prints) rather than collapsing artwork.
    A p-prefixed set is used only if it actually exists on Scryfall.
    """
    codes = [set_code]
    if include_promos and not set_code.startswith("p"):
        promo_code = "p" + set_code
        meta = fetch_json(f"https://api.scryfall.com/sets/{promo_code}")
        if meta.get("object") == "set":
            codes.append(promo_code)
    found = {}
    for code in codes:
        for card in fetch_cards_query(f"e:{code}", unique="prints"):
            if not image_url(card):
                continue
            is_promo = bool(card.get("promo")) or card.get("set_type") == "promo" or code != set_code
            is_variant = bool(card.get("full_art")) or card.get("frame_effects") or card.get("border_color") == "borderless" or bool(card.get("variation")) or bool(card.get("finishes") and "etched" in card["finishes"])
            # Include alternate-art printings that have neither explicit promo
            # nor frame flags: Scryfall's illustration_id distinguishes art.
            if include_promos and is_promo or include_variants and is_variant:
                found[card_key(card)] = card
    return list(found.values())


def substitute_specials(packs, specials, chance, rng):
    """Replace cards with special printings of the same game card.

    Preserves rarity distribution and pack size, including double-faced cards.
    """
    by_oracle = {}
    for card in specials:
        oracle = card.get("oracle_id")
        if oracle:
            by_oracle.setdefault(oracle, []).append(card)
    swaps = 0
    for pack in packs:
        for index, card in enumerate(pack):
            candidates = by_oracle.get(card.get("oracle_id"), [])
            candidates = [c for c in candidates if card_key(c) != card_key(card)]
            if candidates and rng.random() < chance:
                pack[index] = rng.choice(candidates)
                swaps += 1
    return swaps


def face_image_url(card, face_index=0):
    """Return a Scryfall image URL for a particular face of a card.

    Double-faced cards (transform/modal DFC/etc.) commonly store their images
    in card_faces rather than at the top level.
    """
    faces = card.get("card_faces") or []
    if faces and 0 <= face_index < len(faces):
        face = faces[face_index]
        uris = face.get("image_uris") or {}
        url = uris.get("normal") or uris.get("large") or uris.get("png")
        if url:
            return url.split("?")[0]

    # Single-faced cards, and some Scryfall layouts, store the image here.
    if face_index == 0:
        uris = card.get("image_uris") or {}
        url = uris.get("normal") or uris.get("large") or uris.get("png")
        if url:
            return url.split("?")[0]
    return None


def image_url(card):
    """Return the front-face image URL (legacy helper)."""
    return face_image_url(card, 0)


def back_image_url(card):
    """Return the actual reverse face for double-faced cards, if present."""
    faces = card.get("card_faces") or []
    if len(faces) >= 2:
        return face_image_url(card, 1)
    return None


def has_distinct_back_face(card):
    """True when Scryfall supplies a separate image for the card's reverse."""
    return bool(back_image_url(card))


def bucket_by_rarity(cards):
    buckets = {"common": [], "uncommon": [], "rare": [], "mythic": [], "basic": []}
    for card in cards:
        if image_url(card) is None:
            continue
        if "Basic Land" in card.get("type_line", ""):
            buckets["basic"].append(card)
            continue
        rarity = card.get("rarity")
        if rarity in buckets:
            buckets[rarity].append(card)
    return buckets


# ---------------------------------------------------------------------------
# Optional set extras: tokens, emblems, dungeon / Ring reference cards
# ---------------------------------------------------------------------------

def fetch_set_extras(set_codes):
    """Get printed non-deck cards from Scryfall's associated token sets.

    Token-set association comes from Scryfall set metadata (parent_set_code),
    not from a guessed token-set code. Keep each distinct printing/artwork.
    """
    listing = fetch_json("https://api.scryfall.com/sets")
    if listing.get("object") == "error":
        raise RuntimeError("Could not retrieve Scryfall set metadata for extras")
    wanted = {code.lower() for code in set_codes}
    token_codes = set()
    for item in listing.get("data", []):
        code = item.get("code", "").lower()
        parent = (item.get("parent_set_code") or "").lower()
        if item.get("set_type") == "token" and (parent in wanted or code in wanted):
            token_codes.add(code)
    # Also search the requested set itself for non-playable/reference printings.
    # Scryfall's token sets include emblems and cards such as The Ring.
    extras = {}
    for code in sorted(token_codes | wanted):
        print(f"  Checking extras in {code.upper()} ...", flush=True)
        for card in fetch_cards_query(f"e:{code}", unique="prints"):
            layout = card.get("layout", "")
            type_line = card.get("type_line", "")
            is_extra = (card.get("set_type") == "token" or
                        layout in ("token", "double_faced_token", "emblem", "art_series") or
                        any(x in type_line.lower() for x in
                            ("token", "emblem", "dungeon", "attraction", "sticker", "the ring")))
            if is_extra and image_url(card):
                extras[card_key(card)] = card
    result = list(extras.values())
    print(f"  Found {len(result)} distinct token/reference printings.", flush=True)
    return result


def build_extras_object(cards, label, face_urls, back_faces, back_url):
    """Create a separate TTS deck (or single card) for all set extras."""
    obj = make_deck_json(cards, label, face_urls, back_faces, back_url, [80000])
    obj["Description"] = "Set tokens, emblems, and reference cards (not booster contents)"
    obj["Transform"] = tts_transform(x=12, y=1.5, z=0)
    if len(cards) == 1:
        single = obj["ContainedObjects"][0]
        single["CustomDeck"] = obj["CustomDeck"]
        single["Transform"] = obj["Transform"]
        single["Description"] = obj["Description"]
        return single
    return obj


# ---------------------------------------------------------------------------
# Pack building (classic 15-card draft booster)
# ---------------------------------------------------------------------------

def sample_no_dupes(pool, count, rng):
    if len(pool) >= count:
        return rng.sample(pool, count)
    return [rng.choice(pool) for _ in range(count)]


def build_pack(buckets, rng):
    pack = []
    if buckets["mythic"] and rng.random() < MYTHIC_CHANCE:
        pack.append(rng.choice(buckets["mythic"]))
    elif buckets["rare"]:
        pack.append(rng.choice(buckets["rare"]))
    elif buckets["mythic"]:
        pack.append(rng.choice(buckets["mythic"]))
    if buckets["uncommon"]:
        pack.extend(sample_no_dupes(buckets["uncommon"], 3, rng))
    if buckets["common"]:
        pack.extend(sample_no_dupes(buckets["common"], 10, rng))
    if buckets["basic"]:
        pack.append(rng.choice(buckets["basic"]))
    elif buckets["common"]:
        pack.append(rng.choice(buckets["common"]))
    return pack


def build_pool_pack(cards, count, rng):
    """Build a rarity-agnostic pack from any Scryfall card pool."""
    usable = [c for c in cards if image_url(c) is not None]
    if not usable:
        return []
    return sample_no_dupes(usable, count, rng)


def build_weighted_pack(cards, rng, common_slots=10, uncommon_slots=3,
                        rare_slots=1, flex_slots=1, mythic_chance=1 / 8):
    """Build a traditional-feeling pack from an arbitrary card pool.

    Defaults are 10 commons, 3 uncommons, 1 rare/mythic, and 1 flexible
    slot (basic land when available). Missing rarity categories gracefully
    fall back to other eligible cards, which makes this useful for special
    sets and Commander products that were not designed for booster collation.
    """
    usable = [c for c in cards if image_url(c) is not None]
    if not usable:
        return []

    buckets = bucket_by_rarity(usable)
    all_cards = list(usable)
    pack = []

    def choose_from(preferred, allow_duplicates=False):
        # Prefer an unused card from the requested rarity; if that category
        # is absent/exhausted, fall back to any unused card in the pool.
        used_ids = {card_key(c) for c in pack}
        candidates = [c for c in preferred if card_key(c) not in used_ids]
        if not candidates:
            candidates = [c for c in all_cards if card_key(c) not in used_ids]
        if not candidates and allow_duplicates:
            candidates = preferred or all_cards
        if not candidates:
            return None
        return rng.choice(candidates)

    def add_slots(pool, count):
        for _ in range(max(0, count)):
            card = choose_from(pool, allow_duplicates=True)
            if card is not None:
                pack.append(card)

    add_slots(buckets["common"], common_slots)
    add_slots(buckets["uncommon"], uncommon_slots)

    for _ in range(max(0, rare_slots)):
        preferred = (buckets["mythic"] if buckets["mythic"] and
                     rng.random() < mythic_chance else buckets["rare"])
        if not preferred:
            preferred = buckets["rare"] or buckets["mythic"]
        card = choose_from(preferred, allow_duplicates=True)
        if card is not None:
            pack.append(card)

    # Flexible slot: prefer basic lands, then any unused eligible card.
    add_slots(buckets["basic"] or [], flex_slots)

    # If the selected product lacks enough cards in one or more rarity
    # buckets, fill to the requested total using unused cards from the pool.
    target = max(0, common_slots) + max(0, uncommon_slots) + \
             max(0, rare_slots) + max(0, flex_slots)
    while len(pack) < target:
        card = choose_from(all_cards, allow_duplicates=True)
        if card is None:
            break
        pack.append(card)
    return pack


# ---------------------------------------------------------------------------
# Local images
# ---------------------------------------------------------------------------

def default_images_dir():
    if os.name == "nt":
        return r"C:\Users\Public\TTSDraftImages"
    return str(Path.home() / "TTSDraftImages")


def download_file(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=60) as resp, open(dest, "wb") as f:
        f.write(resp.read())


def file_url(path):
    return "file:///" + str(path).replace("\\", "/")


def card_key(card):
    return card.get("id") or card.get("name")


def download_images(packs, images_dir, set_code):
    """Download each unique card's front and, when present, reverse face.

    Returns:
        face_urls: card key -> local front-face URL
        back_faces: card key -> local reverse-face URL (only DFCs)
        default_back: local standard MTG card back URL
        dest: output image directory
    """
    dest = Path(images_dir) / set_code.lower()
    dest.mkdir(parents=True, exist_ok=True)
    unique = {card_key(c): c for pack in packs for c in pack}
    double_faced = sum(1 for c in unique.values() if has_distinct_back_face(c))
    print(f"Downloading {len(unique)} card fronts and {double_faced} reverse faces to {dest} ...")
    face_urls = {}
    back_faces = {}

    for i, (key, card) in enumerate(unique.items(), 1):
        front_target = dest / f"{key}.jpg"
        front_url = image_url(card)
        if front_url:
            if not front_target.exists():
                download_file(front_url, front_target)
                time.sleep(0.1)
            face_urls[key] = file_url(front_target)

        reverse_url = back_image_url(card)
        if reverse_url:
            back_target = dest / f"{key}_back.jpg"
            if not back_target.exists():
                download_file(reverse_url, back_target)
                time.sleep(0.1)
            back_faces[key] = file_url(back_target)

        if i % 50 == 0 or i == len(unique):
            print(f"  {i}/{len(unique)}")

    back_target = dest / "card_back.jpg"
    try:
        if not back_target.exists():
            download_file(CARD_BACK_URL, back_target)
        default_back = file_url(back_target)
    except Exception:
        default_back = CARD_BACK_URL
    print(f"  Detected {len(back_faces)} double-faced card(s).")
    return face_urls, back_faces, default_back, dest


